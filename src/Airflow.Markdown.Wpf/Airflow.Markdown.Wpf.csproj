<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 允许在非 Windows 机器上 restore/编译（如 Linux CI 做语法检查）；Windows 上无副作用 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Airflow.Markdown.Wpf</RootNamespace>
    <PackageId>Airflow.Markdown.Wpf</PackageId>
    <Description>WPF control for the Airflow.Markdown streaming Markdown renderer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Airflow.Markdown.Abstractions\Airflow.Markdown.Abstractions.csproj" />
  </ItemGroup>

</Project>
